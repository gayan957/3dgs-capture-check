# Captures and models are too big for git, but their documentation is not
data/*
!data/README.md

# The feature cache is an exception: it is training data, not a cache. The pair
# table and the coverage grid are written nowhere else, so a clone without them
# trains on zeroed pair tokens and an empty coverage grid without erroring.
# See non-negotiable 9 in CLAUDE.md. ~5 MB for 65 captures.
!data/features/
data/features/*
!data/features/*.npz

models/
reports/figures/*.png
*.joblib
*.pt
*.onnx

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS / editors
.DS_Store
